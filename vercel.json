{
  "framework": "vite",
  "rewrites": [
    { "source": "/api/xata/status", "destination": "/api/xata-status.js" },
    { "source": "/api/turnos", "destination": "/api/turnos.js" },
    { "source": "/api/turnos/(.*)", "destination": "/api/turnos.js?id=$1" },
    { "source": "/((?!assets|api|manifest\\.json|sw\\.js|icon\\.svg|logo\\.jpg|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
